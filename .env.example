# Optional: remote LibSQL / Turso database for serverless deployments (e.g. Vercel)
# Leave unset for local SQLite (local.db)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: Cloudinary for remote frame/photo hosting (local dev falls back to .local-uploads/)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Optional: Payment gateway keys (QRIS sandbox/production)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# DOKU_CLIENT_ID=
# DOKU_B2B_SECRET_KEY=
# DOKU_SECRET_KEY=
# DOKU_MERCHANT_ID=
# DOKU_IS_PRODUCTION=false

# Optional: Pixabay sticker/background search in Admin Template Studio
# PIXABAY_API_KEY=
