{
  "name": "photobooth-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build && node -e \"try{require('fs').unlinkSync('out/_worker.js')}catch(e){}\"",
    "deploy": "npx wrangler deploy",
    "db:setup": "sqlite3 local.db < schema.sql && sqlite3 local.db < scripts/seed.sql",
    "seed": "npx wrangler d1 execute photobox-db --local --file=scripts/seed.sql",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "konva": "^10.3.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.4",
    "react-webcam": "^7.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "@types/uuid": "^9",
    "typescript": "^5"
  }
}
