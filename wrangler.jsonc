{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextjs-velvetsnap-photobox",
  "main": "worker.js",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "PHOTOBOX_DB",
      "database_name": "photobox-db",
      "database_id": "24baf404-a8fb-4481-ab78-31e930973787"
    }
  ],
  "vars": {
    "MIDTRANS_IS_PRODUCTION": "false",
    "DOKU_IS_PRODUCTION": "false",
    "DOKU_CLIENT_ID": "",
    "DOKU_SECRET_KEY": "",
    "DOKU_B2B_SECRET_KEY": "",
    "DOKU_MERCHANT_ID": "",
    "DOKU_TERMINAL_ID": "",
    "DOKU_POSTAL_CODE": ""
  },
  "routes": [
    {
      "pattern": "photo.widifirmaan.web.id",
      "zone_name": "widifirmaan.web.id",
      "custom_domain": true
    }
  ]
}
